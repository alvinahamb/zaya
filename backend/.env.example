# Copier en `backend/.env` pour lancer l'API sans Docker.
# En production (Render), ces valeurs se saisissent dans le dashboard.

PORT=4000
# `production` active le SSL vers la base et exige JWT_SECRET
NODE_ENV=development
TZ=Indian/Antananarivo

# Postgres local, ou Session pooler Supabase (port 5432, sans ?sslmode=…) :
# postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://zaya:zaya@localhost:5432/zaya

# Chaîne aléatoire longue en production
JWT_SECRET=change_moi

# Premier compte admin, créé si la table Utilisateur est vide
ADMIN_EMAIL=admin@zaya.local
ADMIN_MOT_DE_PASSE=admin1234

# URL du front déployé, sans slash final (CORS). Vide en local : tout est autorisé.
FRONTEND_URL=

# Images de produits dans Supabase Storage. Vides en local : dossier uploads/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=produits
