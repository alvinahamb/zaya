generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Achat {
  id                 Int           @id @default(autoincrement())
  nom                String        @db.VarChar(150)
  description        String?
  dateCommande       DateTime?     @db.Date
  dateArriveeEstimee DateTime?     @db.Date
  dateArrivee        DateTime?     @db.Date
  somme              Decimal       @default(0) @db.Decimal(12, 2)
  sommeAr            Decimal       @default(0) @db.Decimal(14, 2)
  dateFigement       DateTime?     @db.Timestamp(6)
  dateCreation       DateTime      @default(now()) @db.Timestamp(6)
  Boost              Boost[]
  DetailAchat        DetailAchat[]
  Frais              Frais[]
  Publication        Publication[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Boost {
  id           Int       @id @default(autoincrement())
  nom          String?   @db.VarChar(150)
  idAchat      Int
  idReseau     Int
  dateBoost    DateTime? @db.Date
  montantAr    Decimal   @default(0) @db.Decimal(14, 2)
  raison       String?
  dateCreation DateTime  @default(now()) @db.Timestamp(6)
  Achat        Achat     @relation(fields: [idAchat], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkBoostAchat")
  Reseau       Reseau    @relation(fields: [idReseau], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkBoostReseau")
  Frais        Frais[]

  @@index([idAchat], map: "idxBoostAchat")
  @@index([idReseau], map: "idxBoostReseau")
}

model Categorie {
  id           Int       @id @default(autoincrement())
  nom          String    @unique @db.VarChar(100)
  dateCreation DateTime  @default(now()) @db.Timestamp(6)
  Produit      Produit[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DetailAchat {
  id           Int           @id @default(autoincrement())
  idAchat      Int
  idProduit    Int
  quantite     Int
  prix         Decimal       @db.Decimal(10, 2)
  margePct     Decimal?      @db.Decimal(6, 2)
  prixVenteAr  Decimal?      @db.Decimal(14, 2)
  dateCreation DateTime      @default(now()) @db.Timestamp(6)
  Achat        Achat         @relation(fields: [idAchat], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkDetailAchatAchat")
  Produit      Produit       @relation(fields: [idProduit], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkDetailAchatProduit")
  DetailVente  DetailVente[]

  @@unique([idAchat, idProduit], map: "uqDetailAchatAchatProduit")
  @@index([idProduit], map: "idxDetailAchatProduit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DetailVente {
  id            Int         @id @default(autoincrement())
  idVente       Int
  idDetailAchat Int
  quantite      Int
  prixVenteAr   Decimal     @db.Decimal(14, 2)
  dateCreation  DateTime    @default(now()) @db.Timestamp(6)
  DetailAchat   DetailAchat @relation(fields: [idDetailAchat], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkDetailVenteDetailAchat")
  Vente         Vente       @relation(fields: [idVente], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkDetailVenteVente")

  @@index([idDetailAchat], map: "idxDetailVenteDetailAchat")
  @@index([idVente], map: "idxDetailVenteVente")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Frais {
  id           Int       @id @default(autoincrement())
  idAchat      Int?
  idBoost      Int?
  libelle      String?   @db.VarChar(150)
  montantAr    Decimal   @db.Decimal(14, 2)
  dateFrais    DateTime? @db.Date
  dateCreation DateTime  @default(now()) @db.Timestamp(6)
  Achat        Achat?    @relation(fields: [idAchat], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkFraisAchat")
  Boost        Boost?    @relation(fields: [idBoost], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkFraisBoost")

  @@index([idAchat], map: "idxFraisAchat")
  @@index([idBoost], map: "idxFraisBoost")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Produit {
  id           Int           @id @default(autoincrement())
  idCategorie  Int
  nom          String        @db.VarChar(150)
  description  String?
  materiel     String?       @db.VarChar(100)
  codeShein    String?       @unique @db.VarChar(50)
  image        String?       @db.VarChar(255)
  prix         Decimal?      @db.Decimal(10, 2)
  prixVenteAr  Decimal?      @db.Decimal(14, 2)
  dateCreation DateTime      @default(now()) @db.Timestamp(6)
  DetailAchat  DetailAchat[]
  Categorie    Categorie     @relation(fields: [idCategorie], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkProduitCategorie")

  @@index([idCategorie], map: "idxProduitCategorie")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Publication {
  id                   Int       @id @default(autoincrement())
  nom                  String    @db.VarChar(150)
  description          String?
  statut               String    @default("a_faire") @db.VarChar(20)
  dateHeurePublication DateTime? @db.Timestamp(6)
  lienPinterest        String?   @db.VarChar(255)
  lienContenu          String?   @db.VarChar(255)
  idReseau             Int?
  idAchat              Int?
  dateCreation         DateTime  @default(now()) @db.Timestamp(6)
  Achat                Achat?    @relation(fields: [idAchat], references: [id], onUpdate: NoAction, map: "fkPublicationAchat")
  Reseau               Reseau?   @relation(fields: [idReseau], references: [id], onUpdate: NoAction, map: "fkPublicationReseau")

  @@index([idAchat], map: "idxPublicationAchat")
  @@index([dateHeurePublication], map: "idxPublicationDate")
  @@index([idReseau], map: "idxPublicationReseau")
}

model Reseau {
  id           Int           @id @default(autoincrement())
  nom          String        @unique @db.VarChar(100)
  lienCompte   String?       @db.VarChar(255)
  dateCreation DateTime      @default(now()) @db.Timestamp(6)
  Boost        Boost[]
  Publication  Publication[]
  Vente        Vente[]
}

model Utilisateur {
  id           Int      @id @default(autoincrement())
  nom          String?  @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  motDePasse   String   @db.VarChar(255)
  role         String   @default("admin") @db.VarChar(20)
  actif        Boolean  @default(true)
  dateCreation DateTime @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Vente {
  id           Int           @id @default(autoincrement())
  nom          String?       @db.VarChar(150)
  idReseau     Int
  dateVente    DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  reductionAr  Decimal       @default(0) @db.Decimal(14, 2)
  sommeAr      Decimal       @default(0) @db.Decimal(14, 2)
  dateCreation DateTime      @default(now()) @db.Timestamp(6)
  DetailVente  DetailVente[]
  Reseau       Reseau        @relation(fields: [idReseau], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkVenteReseau")

  @@index([dateVente], map: "idxVenteDate")
  @@index([idReseau], map: "idxVenteReseau")
}
