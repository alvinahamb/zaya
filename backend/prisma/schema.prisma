generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Achat {
  id                 Int           @id @default(autoincrement())
  nom                String        @db.VarChar(150)
  description        String?
  dateCommande       DateTime?     @db.Date
  dateArriveeEstimee DateTime?     @db.Date
  dateArrivee        DateTime?     @db.Date
  somme              Decimal       @default(0) @db.Decimal(12, 2)
  sommeAr            Decimal       @default(0) @db.Decimal(14, 2)
  dateFigement       DateTime?     @db.Timestamp(6)
  dateCreation       DateTime      @default(now()) @db.Timestamp(6)
  sommeTotale        Decimal?      @db.Decimal(12, 2)
  Budget             Budget[]
  DetailAchat        DetailAchat[]
  Frais              Frais[]
  Publication        Publication[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Boost {
  id            Int           @id @default(autoincrement())
  nom           String?       @db.VarChar(150)
  idPublication Int
  dateBoost     DateTime?     @db.Date
  montantAr     Decimal       @default(0) @db.Decimal(14, 2)
  raison        String?
  dateCreation  DateTime      @default(now()) @db.Timestamp(6)
  Publication   Publication   @relation(fields: [idPublication], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkBoostPublication")
  BoostReseau   BoostReseau[]
  Frais         Frais[]

  @@index([idPublication], map: "idxBoostPublication")
}

model Categorie {
  id           Int       @id @default(autoincrement())
  nom          String    @unique @db.VarChar(100)
  dateCreation DateTime  @default(now()) @db.Timestamp(6)
  Produit      Produit[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DetailAchat {
  id           Int           @id @default(autoincrement())
  idAchat      Int
  idProduit    Int
  quantite     Int
  prix         Decimal       @db.Decimal(10, 2)
  margePct     Decimal?      @db.Decimal(6, 2)
  prixVenteAr  Decimal?      @db.Decimal(14, 2)
  dateCreation DateTime      @default(now()) @db.Timestamp(6)
  Achat        Achat         @relation(fields: [idAchat], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkDetailAchatAchat")
  Produit      Produit       @relation(fields: [idProduit], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkDetailAchatProduit")
  DetailVente  DetailVente[]

  @@unique([idAchat, idProduit], map: "uqDetailAchatAchatProduit")
  @@index([idProduit], map: "idxDetailAchatProduit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DetailVente {
  id            Int         @id @default(autoincrement())
  idVente       Int
  idDetailAchat Int
  quantite      Int
  prixVenteAr   Decimal     @db.Decimal(14, 2)
  dateCreation  DateTime    @default(now()) @db.Timestamp(6)
  DetailAchat   DetailAchat @relation(fields: [idDetailAchat], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkDetailVenteDetailAchat")
  Vente         Vente       @relation(fields: [idVente], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkDetailVenteVente")

  @@index([idDetailAchat], map: "idxDetailVenteDetailAchat")
  @@index([idVente], map: "idxDetailVenteVente")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Frais {
  id           Int       @id @default(autoincrement())
  idAchat      Int?
  idBoost      Int?
  libelle      String?   @db.VarChar(150)
  montantAr    Decimal   @db.Decimal(14, 2)
  dateFrais    DateTime? @db.Date
  dateCreation DateTime  @default(now()) @db.Timestamp(6)
  Achat        Achat?    @relation(fields: [idAchat], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkFraisAchat")
  Boost        Boost?    @relation(fields: [idBoost], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkFraisBoost")

  @@index([idAchat], map: "idxFraisAchat")
  @@index([idBoost], map: "idxFraisBoost")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Produit {
  id           Int           @id @default(autoincrement())
  idCategorie  Int
  nom          String        @db.VarChar(150)
  description  String?
  materiel     String?       @db.VarChar(100)
  codeShein    String?       @unique @db.VarChar(50)
  image        String?       @db.VarChar(255)
  prix         Decimal?      @db.Decimal(10, 2)
  prixVenteAr  Decimal?      @db.Decimal(14, 2)
  dateCreation DateTime      @default(now()) @db.Timestamp(6)
  DetailAchat  DetailAchat[]
  ProduitImage ProduitImage[]
  PublicationProduit PublicationProduit[]
  Categorie    Categorie     @relation(fields: [idCategorie], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkProduitCategorie")

  @@index([idCategorie], map: "idxProduitCategorie")
}

/// Photos secondaires d'un produit (la principale reste dans Produit.image).
model ProduitImage {
  id           Int      @id @default(autoincrement())
  idProduit    Int
  url          String   @db.VarChar(255)
  ordre        Int      @default(0)
  dateCreation DateTime @default(now()) @db.Timestamp(6)
  Produit      Produit  @relation(fields: [idProduit], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkProduitImageProduit")

  @@index([idProduit, ordre], map: "idxProduitImageProduit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Publication {
  id                   Int                 @id @default(autoincrement())
  nom                  String              @db.VarChar(150)
  description          String?
  statut               String              @default("a_faire") @db.VarChar(20)
  /// Type de contenu (publication, story) ; valeurs contrôlées par l'API
  type                 String              @default("publication") @db.VarChar(20)
  dateHeurePublication DateTime?           @db.Timestamp(6)
  lienPinterest        String?             @db.VarChar(255)
  lienContenu          String?             @db.VarChar(255)
  idAchat              Int?
  dateCreation         DateTime            @default(now()) @db.Timestamp(6)
  Boost                Boost[]
  Achat                Achat?              @relation(fields: [idAchat], references: [id], onUpdate: NoAction, map: "fkPublicationAchat")
  PublicationReseau    PublicationReseau[]
  PublicationProduit   PublicationProduit[]

  @@index([idAchat], map: "idxPublicationAchat")
  @@index([dateHeurePublication], map: "idxPublicationDate")
  @@index([type], map: "idxPublicationType")
}

model Reseau {
  id                Int                 @id @default(autoincrement())
  nom               String              @unique @db.VarChar(100)
  lienCompte        String?             @db.VarChar(255)
  dateCreation      DateTime            @default(now()) @db.Timestamp(6)
  BoostReseau       BoostReseau[]
  ClientReseau      ClientReseau[]
  PublicationReseau PublicationReseau[]
  VenteReseau       VenteReseau[]
}

model Utilisateur {
  id           Int      @id @default(autoincrement())
  nom          String?  @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  motDePasse   String   @db.VarChar(255)
  role         String   @default("admin") @db.VarChar(20)
  actif        Boolean  @default(true)
  dateCreation DateTime @default(now()) @db.Timestamp(6)
  /// Empreinte SHA-256 du jeton des Rappels iPhone (null : désactivé)
  jetonRappels String?  @unique @db.VarChar(64)
  MonthlyAchievement MonthlyAchievement[]
  NotificationVue    NotificationVue[]
}

/// Notifications marquées vues par un utilisateur (clé : « id|échéance relative »).
model NotificationVue {
  idUtilisateur Int
  cle           String      @db.VarChar(200)
  dateVue       DateTime    @default(now()) @db.Timestamp(6)
  Utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkNotificationVueUtilisateur")

  @@id([idUtilisateur, cle], map: "pkNotificationVue")
}

/// Objectifs du mois (table `monthly_achievements`, créée par backend/prisma/sql/2026-09-22_monthly_achievements.sql).
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MonthlyAchievement {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  title        String      @db.VarChar(150)
  description  String?
  category     String?     @db.VarChar(50)
  targetValue  Decimal     @map("target_value") @db.Decimal(14, 2)
  currentValue Decimal     @default(0) @map("current_value") @db.Decimal(14, 2)
  unit         String?     @db.VarChar(30)
  startDate    DateTime    @map("start_date") @db.Date
  endDate      DateTime    @map("end_date") @db.Date
  status       String      @default("en_cours") @db.VarChar(20)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  completedAt  DateTime?   @map("completed_at") @db.Timestamp(6)
  Utilisateur  Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_monthly_achievements_user")

  @@index([userId], map: "idx_monthly_achievements_user")
  @@index([endDate], map: "idx_monthly_achievements_end_date")
  @@map("monthly_achievements")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Vente {
  id           Int           @id @default(autoincrement())
  nom          String?       @db.VarChar(150)
  idClient     Int?
  dateVente    DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  reductionAr  Decimal       @default(0) @db.Decimal(14, 2)
  sommeAr      Decimal       @default(0) @db.Decimal(14, 2)
  dateCreation DateTime      @default(now()) @db.Timestamp(6)
  DetailVente  DetailVente[]
  Livraison    Livraison?
  Client       Client?       @relation(fields: [idClient], references: [id], onUpdate: NoAction, map: "fkVenteClient")
  VenteReseau  VenteReseau[]

  @@index([dateVente], map: "idxVenteDate")
  @@index([idClient], map: "idxVenteClient")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Budget {
  id           Int       @id @default(autoincrement())
  idAchat      Int
  libelle      String?   @db.VarChar(150)
  montantAr    Decimal   @db.Decimal(14, 2)
  dateBudget   DateTime? @db.Date
  dateCreation DateTime  @default(now()) @db.Timestamp(6)
  Achat        Achat     @relation(fields: [idAchat], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkBudgetAchat")

  @@index([idAchat], map: "idxBudgetAchat")
}

/// Bijoux présentés dans une publication (pris dans la commande liée).
model PublicationProduit {
  idPublication Int
  idProduit     Int
  Publication   Publication @relation(fields: [idPublication], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkPublicationProduitPublication")
  Produit       Produit     @relation(fields: [idProduit], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkPublicationProduitProduit")

  @@id([idPublication, idProduit], map: "pkPublicationProduit")
  @@index([idProduit], map: "idxPublicationProduitProduit")
}

model PublicationReseau {
  idPublication        Int
  idReseau             Int
  /// Heure propre au réseau ; null = suit Publication.dateHeurePublication
  dateHeurePublication DateTime?   @db.Timestamp(6)
  Publication   Publication @relation(fields: [idPublication], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkPublicationReseauPublication")
  Reseau        Reseau      @relation(fields: [idReseau], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkPublicationReseauReseau")

  @@id([idPublication, idReseau], map: "pkPublicationReseau")
  @@index([idReseau], map: "idxPublicationReseauReseau")
}

model Client {
  id           Int            @id @default(autoincrement())
  nom          String         @db.VarChar(150)
  telephone    String?        @db.VarChar(30)
  adresse      String?
  note         String?
  dateCreation DateTime       @default(now()) @db.Timestamp(6)
  ClientReseau ClientReseau[]
  Livraison    Livraison[]
  Vente        Vente[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Livraison {
  id                    Int       @id @default(autoincrement())
  idVente               Int       @unique
  idClient              Int?
  libelle               String?   @db.VarChar(150)
  adresse               String?
  telephone             String?   @db.VarChar(30)
  livreur               String?   @db.VarChar(100)
  fraisAr               Decimal   @default(0) @db.Decimal(14, 2)
  statut                String    @default("a_programmer") @db.VarChar(20)
  dateHeureAppelLivreur DateTime? @db.Timestamp(6)
  dateHeureLivraison    DateTime? @db.Timestamp(6)
  dateHeureLivree       DateTime? @db.Timestamp(6)
  note                  String?
  dateCreation          DateTime  @default(now()) @db.Timestamp(6)
  Client                Client?   @relation(fields: [idClient], references: [id], onUpdate: NoAction, map: "fkLivraisonClient")
  Vente                 Vente     @relation(fields: [idVente], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkLivraisonVente")

  @@index([idClient], map: "idxLivraisonClient")
  @@index([statut], map: "idxLivraisonStatut")
}

model BoostReseau {
  idBoost  Int
  idReseau Int
  Boost    Boost  @relation(fields: [idBoost], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkBoostReseauBoost")
  Reseau   Reseau @relation(fields: [idReseau], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkBoostReseauReseau")

  @@id([idBoost, idReseau], map: "pkBoostReseau")
  @@index([idReseau], map: "idxBoostReseauReseau")
}

model ClientReseau {
  idClient Int
  idReseau Int
  Client   Client @relation(fields: [idClient], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkClientReseauClient")
  Reseau   Reseau @relation(fields: [idReseau], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkClientReseauReseau")

  @@id([idClient, idReseau], map: "pkClientReseau")
  @@index([idReseau], map: "idxClientReseauReseau")
}

model VenteReseau {
  idVente  Int
  idReseau Int
  Reseau   Reseau @relation(fields: [idReseau], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkVenteReseauReseau")
  Vente    Vente  @relation(fields: [idVente], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkVenteReseauVente")

  @@id([idVente, idReseau], map: "pkVenteReseau")
  @@index([idReseau], map: "idxVenteReseauReseau")
}
