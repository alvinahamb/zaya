# Copier en `.env` à la racine : `cp .env.example .env`
# Ce fichier alimente docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_USER=zaya
POSTGRES_PASSWORD=zaya
POSTGRES_DB=zaya

# --- API ---
JWT_SECRET=change_moi
TZ=Indian/Antananarivo
# Premier compte admin, créé au démarrage si la table Utilisateur est vide
ADMIN_EMAIL=admin@zaya.local
ADMIN_MOT_DE_PASSE=admin1234

# --- Ports exposés sur l'hôte ---
DB_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=5173
